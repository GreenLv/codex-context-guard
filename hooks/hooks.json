{
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/run_context_guard.sh\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\scripts\\run-context-guard.ps1\" hook", "timeout": 10, "statusMessage": "Context Guard is journaling the user request", "additionalContextLimit": 4000}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/run_context_guard.sh\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\scripts\\run-context-guard.ps1\" hook", "timeout": 10, "statusMessage": "Context Guard is recording bounded evidence"}]}],
    "PreCompact": [{"matcher": "manual|auto", "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/run_context_guard.sh\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\scripts\\run-context-guard.ps1\" hook", "timeout": 15, "statusMessage": "Context Guard is saving a recovery packet"}]}],
    "SessionStart": [{"matcher": "resume|compact", "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/run_context_guard.sh\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\scripts\\run-context-guard.ps1\" hook", "timeout": 10, "statusMessage": "Context Guard is restoring task boundaries", "additionalContextLimit": 4000}]}],
    "SubagentStart": [{"matcher": ".*", "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/run_context_guard.sh\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\scripts\\run-context-guard.ps1\" hook", "timeout": 10, "statusMessage": "Context Guard is passing a bounded delegated-task contract", "additionalContextLimit": 3000}]}],
    "SubagentStop": [{"matcher": ".*", "hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/run_context_guard.sh\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\scripts\\run-context-guard.ps1\" hook", "timeout": 10, "statusMessage": "Context Guard is recording the bounded subagent result"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/run_context_guard.sh\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\scripts\\run-context-guard.ps1\" hook", "timeout": 10, "statusMessage": "Context Guard is checking completion evidence"}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "sh \"$PLUGIN_ROOT/scripts/run_context_guard.sh\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\scripts\\run-context-guard.ps1\" hook", "timeout": 2, "statusMessage": "Context Guard is archiving local state"}]}]
  }
}
