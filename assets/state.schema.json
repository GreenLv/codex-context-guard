{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GreenLv/codex-context-guard/blob/main/assets/state.schema.json",
  "title": "Context Guard private session state",
  "type": "object",
  "required": [
    "schema_version",
    "session",
    "mode",
    "prompts",
    "requirements",
    "acceptance_items",
    "supersedes",
    "evidence",
    "evidence_sequence",
    "work_state",
    "agents",
    "open_items",
    "compactions",
    "completion_attempt",
    "completion_checkpoint",
    "continuation_attempts",
    "decision_log",
    "integrity",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": 5},
    "session": {
      "type": "object",
      "required": ["id", "cwd", "created_at", "updated_at", "ended_at"]
    },
    "mode": {
      "type": "object",
      "required": [
        "active",
        "manual_off",
        "complexity_score",
        "activation_reasons"
      ]
    },
    "prompts": {
      "type": "array",
      "description": "Metadata only. Immutable full text lives in private prompts/Pxxxx.json files."
    },
    "requirements": {"type": "array"},
    "acceptance_items": {"type": "array"},
    "supersedes": {"type": "array"},
    "evidence": {"type": "array"},
    "evidence_sequence": {"type": "integer", "minimum": 0},
    "work_state": {
      "type": "object",
      "required": ["plan_snapshot"],
      "properties": {
        "plan_snapshot": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "agents": {"type": "array"},
    "open_items": {"type": "array"},
    "compactions": {"type": "array"},
    "completion_attempt": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "protocol_version",
            "turn_id",
            "token_sha256",
            "created_at",
            "staged_control",
            "staged_at"
          ],
          "properties": {
            "protocol_version": {"const": "1.0.0"},
            "turn_id": {"type": "string"},
            "token_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "created_at": {"type": "string"},
            "staged_at": {"type": ["string", "null"]},
            "staged_control": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "required": ["kind", "checkpoint"],
                  "properties": {
                    "kind": {"const": "checkpoint"},
                    "checkpoint": {"type": "object"}
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["kind", "disposition", "reason"],
                  "properties": {
                    "kind": {"const": "disposition"},
                    "disposition": {
                      "enum": ["continue", "user_wait", "external_wait", "deferred"]
                    },
                    "reason": {
                      "enum": [
                        "assistant_work_remains",
                        "user_action_required",
                        "external_dependency",
                        "denied_or_out_of_scope"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "completion_checkpoint": {"type": ["object", "null"]},
    "continuation_attempts": {"type": "integer", "minimum": 0, "maximum": 2},
    "decision_log": {
      "type": "array",
      "maxItems": 32,
      "description": "Bounded, hash-only Stop decisions. Raw prompt and reply text are forbidden.",
      "items": {
        "type": "object",
        "required": [
          "created_at",
          "turn_id",
          "protocol_version",
          "decision_source",
          "declared_disposition",
          "observed_outcome",
          "classifier_version",
          "outcome",
          "reason_codes",
          "prompt_sha256",
          "reply_sha256",
          "actions"
        ],
        "properties": {
          "created_at": {"type": "string"},
          "turn_id": {"type": "string"},
          "protocol_version": {"type": ["string", "null"]},
          "decision_source": {
            "enum": [
              "protocol_checkpoint",
              "protocol_disposition",
              "nlp_hard_gate",
              "nlp_diagnostic",
              "legacy_classifier",
              "checkpoint",
              "integrity"
            ]
          },
          "declared_disposition": {
            "enum": [null, "complete", "continue", "user_wait", "external_wait", "deferred"]
          },
          "observed_outcome": {
            "enum": [
              "allow_neutral",
              "allow_user_handoff",
              "allow_external_wait",
              "allow_out_of_scope_deferred",
              "gate_completion_claim",
              "gate_authorized_remaining_work",
              "consume_checkpoint",
              "fail_closed_integrity"
            ]
          },
          "classifier_version": {"type": "string"},
          "outcome": {
            "enum": [
              "allow_neutral",
              "allow_user_handoff",
              "allow_external_wait",
              "allow_out_of_scope_deferred",
              "gate_completion_claim",
              "gate_authorized_remaining_work",
              "consume_checkpoint",
              "fail_closed_integrity"
            ]
          },
          "reason_codes": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
          "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reply_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "actions": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": ["category", "owner", "authorization"],
              "properties": {
                "category": {"type": "string"},
                "owner": {"enum": ["assistant", "user", "external"]},
                "authorization": {"enum": ["authorized", "denied", "out_of_scope", "user_only", "external_dependency"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "integrity": {
      "type": "object",
      "required": ["status", "issue", "recovered_at", "backup_file"],
      "properties": {
        "status": {
          "enum": ["ok", "recovered_from_prompts", "failed"]
        },
        "issue": {"type": ["string", "null"]},
        "recovered_at": {"type": ["string", "null"]},
        "backup_file": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
