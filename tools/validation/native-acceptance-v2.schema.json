{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GreenLv/codex-context-guard/tools/validation/native-acceptance-v2.schema.json",
  "title": "native-acceptance/v2 result",
  "description": "Result document for the versioned native-acceptance entrypoint. gate_profile portable_runtime covers exact-runtime portable gates on a clean source commit; gate_profile host_behavior covers real-host behavior captures validated from host event records only. The two profiles are separate evidence: a portable result never satisfies a host_behavior obligation.",
  "type": "object",
  "required": [
    "schema",
    "status",
    "product",
    "gate_profile",
    "repository",
    "runtime_tree_sha256",
    "platform",
    "gates",
    "cleanup",
    "unperformed_actions"
  ],
  "properties": {
    "schema": {"const": "native-acceptance/v2"},
    "status": {"enum": ["passed", "failed", "pending"]},
    "product": {"const": "codex_context_guard"},
    "gate_profile": {"enum": ["portable_runtime", "host_behavior"]},
    "subject": {
      "type": "object",
      "required": ["kind", "source_commit", "prepared_source_sha256", "runtime_tree_sha256"],
      "properties": {
        "kind": {"type": "string"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "prepared_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "repository": {
      "type": "object",
      "properties": {
        "url": {"type": ["string", "null"]},
        "commit": {"type": "string"}
      }
    },
    "runtime_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": ["object", "null"]},
    "platform": {
      "type": "object",
      "required": ["os", "shell", "toolchain"],
      "properties": {
        "os": {"type": "string"},
        "shell": {"type": "string"},
        "toolchain": {
          "type": "object",
          "required": ["python", "codex"],
          "properties": {
            "python": {"type": "string"},
            "codex": {"type": "string"}
          }
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["session_id", "scenarios"],
        "properties": {
          "session_id": {"type": "string"},
          "scenarios": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "required", "status", "subject", "exit_code", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "required": {"type": "boolean"},
          "status": {"enum": ["passed", "failed", "pending"]},
          "chain": {
            "description": "Parser-only causal-chain verdict, distinct from host acceptance.",
            "enum": ["absent", "incomplete", "valid", "contradicted"]
          },
          "subject": {
            "type": "object",
            "required": ["kind", "id"],
            "properties": {
              "kind": {"type": "string"},
              "id": {"type": "string"}
            }
          },
          "exit_code": {"type": "integer"},
          "note": {"type": ["string", "null"]},
          "evidence": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {"type": "string"},
              "source_result_sha256": {"type": ["string", "null"]},
              "source_gate_id": {"type": ["string", "null"]},
              "invalidation_reason": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "visibility": {
      "type": "object",
      "required": ["full_result_is_public", "public_annex_sanitized"],
      "properties": {
        "full_result_is_public": {"type": "boolean"},
        "public_annex_sanitized": {"type": "boolean"},
        "host_passed_reachable": {"type": "boolean"}
      }
    },
    "validation": {
      "oneOf": [
        {
          "description": "Validation-tool identity, separate from the tested product subject.",
          "type": "object",
          "required": [
            "schema",
            "validator_sha256",
            "mapping_manifest_sha256",
            "adapter_sha256",
            "collector_sha256",
            "trust_contract_sha256"
          ],
          "properties": {
            "schema": {
              "const": "host-behavior-validator/v3"
            },
            "validator_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "mapping_manifest_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "adapter_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "collector_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "trust_contract_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "validator_sha256",
            "composite_manifest_sha256",
            "platform_alias_policy",
            "children"
          ],
          "properties": {
            "schema": {
              "const": "host-behavior-composite/v1"
            },
            "validator_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "composite_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "platform_alias_policy": {
              "type": "string",
              "minLength": 1
            },
            "children": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "manifest_sha256",
                  "result_sha256",
                  "tool_sha256",
                  "fresh_receipt_sha256",
                  "gates",
                  "sessions",
                  "platform_original",
                  "original_validation",
                  "capture_configuration"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "git_trust",
                      "continuity"
                    ]
                  },
                  "manifest_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "result_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "tool_sha256": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "fresh_receipt_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "gates": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "sessions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "platform_original": {
                    "type": "object"
                  },
                  "original_validation": {
                    "type": "object"
                  },
                  "capture_configuration": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "validator_sha256",
            "composite_manifest_sha256",
            "platform_alias_policy",
            "children",
            "executable_identity_scope"
          ],
          "properties": {
            "schema": {
              "const": "host-behavior-composite/v2"
            },
            "validator_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "composite_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "platform_alias_policy": {
              "type": "string",
              "minLength": 1
            },
            "children": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "manifest_sha256",
                  "result_sha256",
                  "tool_sha256",
                  "fresh_receipt_sha256",
                  "gates",
                  "sessions",
                  "platform_original",
                  "original_validation",
                  "capture_configuration",
                  "capture_view_replay"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "git_trust",
                      "continuity"
                    ]
                  },
                  "manifest_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "result_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "tool_sha256": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "fresh_receipt_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "gates": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "sessions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "platform_original": {
                    "type": "object"
                  },
                  "original_validation": {
                    "type": "object"
                  },
                  "capture_configuration": {
                    "type": "object"
                  },
                  "capture_view_replay": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema",
                      "original_directory",
                      "archive_root",
                      "archive_files",
                      "original_files",
                      "transaction_directory",
                      "mode",
                      "restored",
                      "writer_exclusion"
                    ],
                    "properties": {
                      "schema": {
                        "const": "offline-capture-view-replay/v1"
                      },
                      "original_directory": {
                        "type": "string",
                        "minLength": 1
                      },
                      "archive_root": {
                        "type": "string",
                        "minLength": 1
                      },
                      "archive_files": {
                        "type": "object",
                        "minProperties": 1,
                        "maxProperties": 4096,
                        "propertyNames": {
                          "pattern": "^capture-[0-9]{6}\\.(raw|meta\\.json)$"
                        },
                        "additionalProperties": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "original_files": {
                        "type": "object",
                        "minProperties": 1,
                        "maxProperties": 4096,
                        "propertyNames": {
                          "pattern": "^capture-[0-9]{6}\\.(raw|meta\\.json)$"
                        },
                        "additionalProperties": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "transaction_directory": {
                        "type": "string",
                        "minLength": 1
                      },
                      "mode": {
                        "const": "temporary_canonical_path_switch"
                      },
                      "restored": {
                        "const": true
                      },
                      "writer_exclusion": {
                        "const": "external_quiescence_required; lock_coordinates_replayers_only"
                      }
                    }
                  }
                }
              }
            },
            "executable_identity_scope": {
              "const": "version compatibility only; no shared executable byte identity is proved"
            }
          }
        }
      ]
    },
    "cleanup": {
      "type": "object",
      "required": ["status", "remaining_ids"],
      "properties": {
        "status": {"type": "string"},
        "remaining_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "public_annex": {
      "type": "object",
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_type", "scenario_id", "payload_sha256"],
            "properties": {
              "event_type": {"type": "string"},
              "scenario_id": {"type": "string"},
              "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "capability_note": {"type": "string"},
    "run": {
      "type": "object",
      "properties": {
        "started_at": {"type": ["string", "null"]},
        "finished_at": {"type": ["string", "null"]},
        "run_url": {"type": ["string", "null"]}
      }
    },
    "unperformed_actions": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
